# Variáveis de build do gutoexplorer. Copie para `.env.local` só se precisar
# mudar o padrão; em produção elas vêm do host (Vercel) ou do workflow (Pages).

# Origem do site, sem caminho e sem barra final.
# Vazio = http://localhost:3000. Na Vercel, produção sem esta variável usa o
# domínio do projeto (VERCEL_PROJECT_PRODUCTION_URL) automaticamente.
NEXT_PUBLIC_SITE_URL=

# Subpasta onde o site é publicado. Vazio = raiz do domínio.
# GitHub Pages de projeto: /portifolio (o `npm run build:pages` deriva sozinho).
NEXT_PUBLIC_BASE_PATH=

# Marca o build como prévia (robots noindex, sem canonical e sem sitemap).
# O `npm run build:pages` já define. Deixe vazio no deploy de verdade.
NEXT_PUBLIC_DEPLOY_TARGET=

# Atalhos do script de Pages, quando roda fora do GitHub Actions:
# PAGES_SITE_URL=https://usuario.github.io
# PAGES_BASE_PATH=/portifolio
